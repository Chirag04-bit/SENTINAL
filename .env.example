# ─── SENTINEL Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. This file (.env.example) IS committed — it is safe.

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Backend API base URL. Change to https://your-render-app.onrender.com in production.
VITE_API_URL=http://localhost:8000

# Demo mode: set to 'false' to enforce real auth (login required).
# Set to 'true' (default) to allow dashboard exploration without logging in.
VITE_DEMO_MODE=true

# App name (used in page titles)
VITE_APP_NAME=SENTINEL

# ─── Backend (Python / FastAPI) ───────────────────────────────────────────────
# Secret key for JWT signing. Use a long random string in production.
SECRET_KEY=your-secret-key-change-this-in-production

# JWT token expiry in minutes (default: 480 minutes = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database URL (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./database/sentinel.db

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment name (development | production)
ENVIRONMENT=development

# ─── ML Model Paths ───────────────────────────────────────────────────────────
FRAUD_MODEL_PATH=ml/saved_models/fraud_model.pkl
INTRUSION_MODEL_PATH=ml/saved_models/intrusion_model.pkl
