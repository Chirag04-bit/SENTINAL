{
  "manifest_version": 3,
  "name": "SENTINEL Security Shield",
  "version": "1.0",
  "description": "Active Tab Scanner & Threat Auditor for SENTINEL AI Cybersecurity Assistant.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
